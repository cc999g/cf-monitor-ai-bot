# ============================================================
# CF Monitor AI Bot 部署配置模板
# 用法：复制本文件为 .env，填入你的值，然后运行 deploy 脚本
#   Windows:  powershell -ExecutionPolicy Bypass -File .\deploy.ps1
#   Linux/Mac: ./deploy.sh
# 必填项必须填；选填项留空会自动生成随机值（部署后会打印给你）
# ============================================================

# ---- 必填 ----
# Cloudflare API Token（建议 Edit All Resources 权限）
CF_API_TOKEN=
# Cloudflare 账户 ID（Dashboard 首页右侧）
CF_ACCOUNT_ID=
# Telegram Bot Token（@BotFather 创建，格式 123456:ABC...）
TG_BOT_TOKEN=
# 超级管理员 Telegram Chat ID（永远是管理员，免邀请码）
TG_CHAT_ID=

# ---- 选填（留空则自动生成，部署后打印） ----
# 管理员邀请码 / 普通成员邀请码（至少 6 位）
TG_ACCESS_CODE=
TG_MEMBER_CODE=
# /setup 管理入口密钥（自动生成长随机串）
SETUP_KEY=
# Webhook 签名密钥（自动生成长随机串）
TG_WEBHOOK_SECRET=

# ---- 选填 ----
# KV 命名空间名称（不存在会自动创建；默认 cf-bot-access）
KV_NAMESPACE=cf-bot-access
# 你的 workers 子域名（如 nezsad），填了会打印可直接执行的 webhook 注册命令
WORKER_SUBDOMAIN=
